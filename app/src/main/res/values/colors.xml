<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirrors LegacyLightColors.background; painted before the first Compose frame. -->
    <color name="eta_window_background">#FAFAF8</color>

    <!--
        The widget cannot read EtaTheme: RemoteViews are inflated by the
        launcher, in the launcher's process, long before any Compose tree
        exists. These five mirror LegacyLightColors by hand, with the night
        variants alongside, and are the only place the palette is duplicated.
    -->
    <color name="eta_widget_surface">#FFFFFF</color>
    <color name="eta_widget_border">#E4E2DD</color>
    <color name="eta_widget_text">#1A1A17</color>
    <color name="eta_widget_muted">#8E8B83</color>
    <color name="eta_widget_accent">#4F46E5</color>

    <!--
        The same five for the Eta design, mirroring EtaRedColors. No night
        variants: that design is light whatever the device says.
    -->
    <color name="eta_red_widget_surface">#FFFFFF</color>
    <color name="eta_red_widget_border">#ECE6E4</color>
    <color name="eta_red_widget_text">#1B1717</color>
    <color name="eta_red_widget_muted">#978D8A</color>
    <color name="eta_red_widget_accent">#E5322D</color>

    <!-- And for Eta Dunkel, mirroring EtaRedDarkColors. -->
    <color name="eta_red_dark_widget_surface">#1E1A1B</color>
    <color name="eta_red_dark_widget_border">#372E2F</color>
    <color name="eta_red_dark_widget_text">#F5F0EF</color>
    <color name="eta_red_dark_widget_muted">#857A78</color>
    <color name="eta_red_dark_widget_accent">#EB4640</color>

    <!--
        Three more sets, for a brightness the user fixed or a design that follows
        the phone: the red one that switches (its night twin is in values-night),
        and legacy pinned light and pinned dark.
    -->
    <color name="eta_red_auto_widget_surface">#FFFFFF</color>
    <color name="eta_red_auto_widget_border">#ECE6E4</color>
    <color name="eta_red_auto_widget_muted">#978D8A</color>
    <color name="eta_red_auto_widget_accent">#E5322D</color>
    <color name="eta_legacy_light_widget_surface">#FFFFFF</color>
    <color name="eta_legacy_light_widget_border">#E4E2DD</color>
    <color name="eta_legacy_light_widget_muted">#8E8B83</color>
    <color name="eta_legacy_light_widget_accent">#4F46E5</color>
    <color name="eta_legacy_dark_widget_surface">#1B1B1F</color>
    <color name="eta_legacy_dark_widget_border">#2E2E36</color>
    <color name="eta_legacy_dark_widget_muted">#77756F</color>
    <color name="eta_legacy_dark_widget_accent">#818CF8</color>
</resources>
