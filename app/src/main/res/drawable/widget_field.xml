<?xml version="1.0" encoding="utf-8"?>
<!--
    Looks like the text field it opens. A widget cannot hold a real one —
    RemoteViews has no editable view — so this is the tap target that leads to
    the field, drawn to say as much.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/erik_widget_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/erik_widget_accent" />
    <corners android:radius="10dp" />
</shape>
